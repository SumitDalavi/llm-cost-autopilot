# LLM Keys
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Ollama (local models) - runs at localhost by default
OLLAMA_BASE_URL=http://localhost:11434

# Server
PORT=3000
NODE_ENV=development

# Quality verification
# Set to "true" to run async quality verification on every routed call
QUALITY_VERIFICATION_ENABLED=true

# SQLite database path
DB_PATH=./data/autopilot.db

# Logging
LOG_LEVEL=info

# Routing config path (optional override)
ROUTING_CONFIG_PATH=./config/routing.yaml
