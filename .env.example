# .env.example — llm-cost-autopilot
# Copy to .env and fill in values to activate live backends. Leave blank for mock mode.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  PROGRESSIVE CREDENTIAL LOADING (PCL)                                   │
# │  No keys needed to run. Add keys to unlock production-grade backends.   │
# └─────────────────────────────────────────────────────────────────────────┘

# ── Database ─────────────────────────────────────────────────────────────
# UNSET (default): SQLite via sql.js (zero external dependencies, CI-safe)
# SET to postgres URL: PostgreSQL (CloudSQL, RDS, Neon, Supabase, etc.)
DATABASE_URL=

# ── AI Providers ─────────────────────────────────────────────────────────
# UNSET or sk-dummy (default): Deterministic mock response (zero external calls)
# SET to OpenAI key (sk-...): Live GPT-4o, GPT-4o-mini, etc.
OPENAI_API_KEY=

# SET to Anthropic key (sk-ant-...): Live Claude-3-5-Sonnet, Haiku, etc.
ANTHROPIC_API_KEY=

# Ollama (local models) - runs at localhost by default
OLLAMA_BASE_URL=http://localhost:11434

# ── Configuration & Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
DB_PATH=./data/autopilot.db
QUALITY_VERIFICATION_ENABLED=false
LOG_LEVEL=info
ROUTING_CONFIG_PATH=./config/routing.yaml
